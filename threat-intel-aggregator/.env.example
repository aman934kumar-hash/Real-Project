# ================================================================
# Threat Intelligence Aggregator — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file with real secrets to version control.
# ================================================================

# ── Application ─────────────────────────────────────────────────
APP_NAME="Threat Intelligence Aggregator"
APP_VERSION="1.0.0"
DEBUG=false
API_PREFIX="/api/v1"

# ── Database ─────────────────────────────────────────────────────
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/threat_intel
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ── Security ─────────────────────────────────────────────────────
SECRET_KEY=replace-with-a-random-32-char-string
# Comma-separated list of valid API keys for the internal API.
# Leave empty to disable API key authentication during development.
INTERNAL_API_KEYS=

# ── Rate limiting ────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
ENRICHMENT_CACHE_TTL_SECONDS=3600

# ── Threat Feed API Keys ─────────────────────────────────────────
# AlienVault OTX — free account at https://otx.alienvault.com
OTX_API_KEY=

# VirusTotal — free tier (4 req/min) at https://www.virustotal.com
VIRUSTOTAL_API_KEY=

# AbuseIPDB — free tier (1 000 req/day) at https://www.abuseipdb.com
ABUSEIPDB_API_KEY=

# ── Scheduler ───────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# ── HTTP client ─────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_RETRY_BACKOFF_FACTOR=1.5
